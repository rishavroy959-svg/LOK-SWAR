  <style>
    html,
    body,
    #root {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      min-height: 100vh;
      font-family: 'Outfit', sans-serif;
    }

    .hero-dot-pattern {
      background-color: #f8fafc;
      background-image: radial-gradient(rgba(100, 116, 139, 0.22) 1.2px, transparent 1.2px);
      background-size: 24px 24px;
    }

    .dark .hero-dot-pattern,
    html.dark .hero-dot-pattern,
    body.dark .hero-dot-pattern {
      background-color: #020617 !important;
      background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1.2px, transparent 1.2px) !important;
      background-size: 24px 24px !important;
    }
  </style>
</head>


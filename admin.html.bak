    const localizeAddress = (addressStr, lang = 'en') => {
      if (!addressStr) return "";
      if (lang === 'en') return addressStr;
      let result = String(addressStr);
      Object.keys(LOCATION_TRANSLATIONS).forEach(key => {
        const regex = new RegExp(`\\b${key}\\b`, 'gi');
        const transObj = LOCATION_TRANSLATIONS[key];
        const replacement = transObj[lang] || transObj.hi || key;
        result = result.replace(regex, replacement);
      });
      return result;
    };

# Server Configuration
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/citizen_portal_db
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/citizen_portal_db?retryWrites=true&w=majority

# File Upload Limit
MAX_FILE_SIZE_MB=10

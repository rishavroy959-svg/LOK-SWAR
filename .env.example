# ====================================================================
# LOK SWAR - PRODUCTION ENVIRONMENT & SMS GATEWAY CONFIGURATION
# ====================================================================

# Server Port
PORT=8000

# 1. MongoDB Database (Atlas Cloud or Local)
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.8zc9thi.mongodb.net/lok_swar_db?retryWrites=true&w=majority&appName=Cluster0

# 2. REAL SMS GATEWAY PROVIDERS (Choose either Option A or Option B):

# OPTION A: Fast2SMS (Recommended for India - Quick OTPs to any real mobile number)
# Get free API key instantly at: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# OPTION B: Twilio (Global SMS Delivery)
# Get credentials at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OPTION C: MSG91 (Official Enterprise Indian Telecom Gateway)
# Get credentials at: https://msg91.com/
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
